# Development environment for the web app. Copy to apps/web/.env.local.
# Production is configured through infra/docker/.env.prod and documented in
# infra/docker/README.md, where both of these come from DOMAIN.

# The API the browser calls. Inlined into the browser bundle at build time, so
# a change needs a rebuild. Absolute here because development runs the web app
# and the API on two ports; production serves the API under /api on the same
# hostname and uses the relative "/api/v1", which is what lets one built image
# run on any domain.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Absolute base for social preview URLs, which crawlers reject when relative.
# No NEXT_PUBLIC_ prefix: it is read on the server at request time, so it
# configures a running container rather than a built image.
SITE_URL=http://localhost:3000

# For opening the app from a phone. Next refuses to serve its dev assets to
# any origin but localhost, so the page renders and never hydrates until the
# host is listed here (next.config.ts reads it). Over plain http on a LAN
# address the Secure session cookie is dropped and login cannot work; put an
# HTTPS tunnel in front of port 3000 instead, list its host here, point
# NEXT_PUBLIC_API_BASE above at https://<tunnel>/api/v1, and set
# DEV_API_PROXY_TARGET so the same origin serves the API. Most tunnels refuse
# the dev server's websocket, which leaves pages unhydrated: serve a build
# (bun run build && bun run start) for tunnel testing.
ALLOWED_DEV_ORIGINS=
DEV_API_PROXY_TARGET=

# Who operates this instance, shown on /privacy and /terms. Both pages return
# 404 unless both are set, and the footer links to them only then, so that a
# published image never serves a policy naming whoever built it. Set them here
# to see the pages while working on them; the values do not have to be real in
# development. Production sets the same two in infra/docker/.env.prod.
LEGAL_ENTITY=Example Lda
LEGAL_CONTACT_EMAIL=privacy@example.com
