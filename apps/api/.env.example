# Development environment for the API. `scripts/ci.sh prepare` copies it to
# apps/api/.env and fills in the Garage key pair; `cargo run` and every test
# suite read it, and CI uses it unchanged. It describes a laptop running
# docker-compose.dev.yml: Postgres on 5433, Redis, Garage and Mailpit, all
# local. Several values below are far from production so the suites can
# observe what they test inside a few seconds; each says why.
#
# Production is configured elsewhere: infra/docker/.env.prod, documented in
# infra/docker/README.md. Nothing in this file is read there, and the
# production default for every tuning value lives in src/config.rs.

DATABASE_URL=postgres://krypta:krypta_dev_password@localhost:5433/krypta
REDIS_URL=redis://localhost:6379
PORT=8080

# The dev Garage container. `scripts/ci.sh prepare` fills in the key pair
# below; the manual bootstrap commands are in infra/docker/garage.toml.example.
# The signing region can be anything for Garage; it is a real setting only
# because hosted S3 checks it.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=krypta
# Short so attachments_test can watch a reservation go stale and be reaped
# inside its 4-second poll (production: 30, 120 and 60). The stale window must
# exceed the operation timeout, which config.rs enforces; 3s is still ample
# for the local Garage container.
S3_OPERATION_TIMEOUT_SECONDS=3
ATTACHMENT_UPLOAD_STALE_SECONDS=4
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=1
# Enables the x-krypta-test-pause-upload header one attachments test uses to
# observe an in-flight upload. Development only; production never sets it.
KRYPTA_ATTACHMENT_TEST_HOOKS=1

# Rate limits the suites would trip at their production values (5, 5, 5 and
# 10). The e2e fixture registers one account per worker and the integration
# suites log in and verify far more often than a person would. Other limits
# below are raised the same way, and each says so where it is set; anything
# with no such comment is at its production value.
REGISTER_RATE_LIMIT_PER_HOUR=500
REGISTER_EMAIL_RATE_LIMIT_PER_HOUR=50
LOGIN_RATE_LIMIT_PER_MINUTE=500
VERIFY_RATE_LIMIT_PER_MINUTE=100

# Leave empty here. admin_test claims the bootstrap admin itself and resets
# the claim afterwards, so a real admin on this database would be unclaimed by
# a test run; `scripts/ci.sh integration` refuses to run that suite when one
# exists. Setting a bootstrap admin for a real instance is a production
# concern; see infra/docker/README.md.
KRYPTA_INITIAL_ADMIN_EMAIL=

# Mailpit from docker-compose.dev.yml: plaintext SMTP on 1025, delivers
# nothing outside the machine, and the suites read codes back from its API on
# 8025. SMTP_TLS=none exists for this container and nothing else.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=none
MAIL_FROM="krypta <no-reply@localhost>"

VERIFY_CODE_TTL_SECONDS=900
VERIFY_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60

# The dev web server. It is the one allowed browser origin and the base for
# every link in an email.
WEB_BASE_URL=http://localhost:3000

# Empty: the API is reached directly here, so the TCP peer is the client and
# X-Forwarded-For is ignored. The production compose file sets this to the
# proxy's subnet.
TRUSTED_PROXY_CIDRS=

# Extra browser origins, comma separated, for opening the dev server from a
# phone on the LAN: WEB_BASE_URL stays allowed alongside them. Origins only,
# no path. Example: CORS_ALLOWED_ORIGINS=http://192.168.1.50:3000
CORS_ALLOWED_ORIGINS=

INVITE_RATE_LIMIT_PER_HOUR=20
INVITE_RATE_LIMIT_PER_DAY=100
# Raised for sharing_test, which invites one address many times (production: 3).
INVITE_RECIPIENT_RATE_LIMIT_PER_HOUR=500
INVITE_CONTINUATION_RATE_LIMIT_PER_HOUR=30

# Short so notifications_test observes a notification inside its poll window
# (production: 3600 and 30). Mailpit catches every one of them.
RESPONSE_NOTIFY_COOLDOWN_SECONDS=2
RESPONSE_NOTIFY_SWEEP_INTERVAL_SECONDS=1

# Raised because recovery_test starts about eleven recoveries and verifies
# most of them inside one minute (production: 5 and 5). The attempt cap below
# is a security property and is never raised.
RECOVER_START_RATE_LIMIT_PER_HOUR=500
RECOVER_VERIFY_RATE_LIMIT_PER_MINUTE=100
RECOVER_MAX_ATTEMPTS=5

# Passkeys against the dev web server. The origin's domain must equal the RP
# ID or the relying party refuses to build.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
PASSKEY_RATE_LIMIT_PER_MINUTE=10

# Billing stays off unless all five are set. Keep them commented out here:
# billing_test needs them (a dummy sk_test_ key and any webhook secret
# string suffice, since nothing calls Stripe and the secret's format is
# never checked), but with them on the free plan's ten-open-forms limit
# applies and the Playwright suite exceeds it.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard/settings
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
