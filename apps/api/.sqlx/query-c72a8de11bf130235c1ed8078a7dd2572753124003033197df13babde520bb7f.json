{
  "db_name": "PostgreSQL",
  "query": "SELECT\n            id,\n            actor_user_id,\n            target_user_id,\n            action,\n            result,\n            created_at\n         FROM admin_audit_events\n         WHERE ($1::text IS NULL OR action = $1)\n           AND ($2::text IS NULL OR result = $2)\n           AND (\n                $3::timestamptz IS NULL\n                OR $4::uuid IS NULL\n                OR (created_at, id) < ($3, $4)\n           )\n         ORDER BY created_at DESC, id DESC\n         LIMIT $5",
