metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32"
metrics_token = "REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32"

# Garage is the dev and smoke stack's object store only; production points
# the S3_* variables at an external provider (see docker-compose.prod.yml).
# `scripts/ci.sh prepare` does all of this, writes this file's secrets, and
# fills in apps/api/.env. By hand instead: once the garage container is
# healthy, prefix each with
#   docker compose -f docker-compose.dev.yml exec garage
#
#   /garage node id                                  # copy the id it prints
#   /garage layout assign -z dc1 -c 50G <node-id>    # capacity is a soft label
#   /garage layout apply --version 1
#   /garage bucket create krypta
#   /garage key create krypta-api                    # prints the S3 key pair
#   /garage bucket allow --read --write --owner krypta --key krypta-api
#
# Put the printed key id and secret into apps/api/.env as S3_ACCESS_KEY and
# S3_SECRET_KEY.
