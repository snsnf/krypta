# Copy to infra/docker/.env.prod and fill in. Read by docker-compose.prod.yml
# and backup.sh. Every value marked REQUIRED has no safe default. README.md in
# this directory explains each setting and the order to set things up in.

# REQUIRED. The one public hostname.
DOMAIN=forms.example.com

# Optional. The WebAuthn relying-party ID; defaults to DOMAIN. It is baked into
# every passkey enrolled against it and can only ever be narrowed by a move,
# never widened, so set it to the registrable apex (example.com) if other
# hostnames under it will ever share these accounts. A passkey enrolled
# against the apex keeps working from forms.example.com, secrets.example.com
# and the apex itself. See README.md, "Choosing the hostname".
WEBAUTHN_RP_ID=

# REQUIRED. Where Let's Encrypt sends expiry and problem notices.
ACME_EMAIL=ops@example.com

# backup.sh: a nightly encrypted pg_dump. Attachments need no backup of
# their own; the object store above is durable and versioned.
# REQUIRED for backups: an age public key (age1...). The private key stays
# OFF this machine; a backup that can be decrypted where it was taken
# protects against nothing. Generate the pair with `age-keygen`.
BACKUP_AGE_RECIPIENT=
# Where the encrypted dumps land locally (default ./backups next to this
# file) and how many days to keep them there (default 14).
BACKUP_DIR=
BACKUP_KEEP_DAYS=
# Off-site copy: a SECOND bucket, with its own key that can write but not
# delete, so a compromised server cannot erase its own history. Uploaded with
# the AWS CLI (`aws`), which must be installed on the host. Leave the bucket
# empty to keep backups local only, which is not a backup of the server.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
# The bucket name is also passed to the API, which reads nothing but its
# presence so the admin health view can say whether backups go off-site.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# REQUIRED. openssl rand -hex 32
# Hex, not base64: the password is placed inside the database URL, where a
# '/' or '+' from base64 breaks it and the API cannot connect.
POSTGRES_PASSWORD=

# REQUIRED. The S3-compatible object store that holds every (encrypted)
# attachment. Garage is not used in production; see docker-compose.prod.yml.
# Backblaze B2 example: create a private bucket, then an application key
# restricted to that bucket with read, write, list and delete. The endpoint
# and region are shown on the bucket page and must agree with each other, or
# every request fails signature validation.
#   S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
#   S3_REGION=eu-central-003
# Turn the bucket's lifecycle to "keep only the last version" (or hide-then-
# delete after a few days). B2 buckets keep every version by default, and the
# API's attachment cleanup would otherwise hide objects forever instead of
# freeing them.
# Cloudflare R2 example: the region is always the literal "auto", not the
# bucket's location, and R2 does not version objects, so a delete is final
# and no lifecycle rule is needed for the cleanup to free space.
#   S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# REQUIRED. A real relay with transport encryption. Plaintext SMTP is only for
# the mailpit container in the dev and smoke stacks.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM="krypta <no-reply@forms.example.com>"

# Optional. First-start-only administrator bootstrap: the exact address that
# will register and verify first becomes the instance admin once it has
# enrolled TOTP and completed a TOTP login. Changing it afterwards does not
# create another admin. See README.md, "The first administrator".
KRYPTA_INITIAL_ADMIN_EMAIL=

# Optional. Stripe billing for a hosted instance. All five or none: with any
# of them blank, billing stays off and no billing route exists. See README.md,
# "Billing".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Optional tuning. Every one of these has a production default that is right
# for a public instance, and a blank value means "use the default". They are
# listed so an operator can find them; README.md, "Tuning", says what each
# does and when it is worth changing. Rate limits are per client address as
# seen through Traefik.
REGISTER_RATE_LIMIT_PER_HOUR=
REGISTER_EMAIL_RATE_LIMIT_PER_HOUR=
LOGIN_RATE_LIMIT_PER_MINUTE=
VERIFY_RATE_LIMIT_PER_MINUTE=
VERIFY_CODE_TTL_SECONDS=
VERIFY_MAX_ATTEMPTS=
RESEND_COOLDOWN_SECONDS=
PASSKEY_RATE_LIMIT_PER_MINUTE=
RECOVER_START_RATE_LIMIT_PER_HOUR=
RECOVER_VERIFY_RATE_LIMIT_PER_MINUTE=
RECOVER_MAX_ATTEMPTS=
INVITE_RATE_LIMIT_PER_HOUR=
INVITE_RATE_LIMIT_PER_DAY=
INVITE_RECIPIENT_RATE_LIMIT_PER_HOUR=
INVITE_CONTINUATION_RATE_LIMIT_PER_HOUR=
RESPONSE_NOTIFY_COOLDOWN_SECONDS=
RESPONSE_NOTIFY_SWEEP_INTERVAL_SECONDS=
S3_OPERATION_TIMEOUT_SECONDS=
ATTACHMENT_UPLOAD_STALE_SECONDS=
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=

# Optional. Who operates this instance, shown on /privacy and /terms.
#
# Both pages are served only when these are set, and the footer links to them
# only then. That is deliberate: those pages are promises made by a named
# operator to their own users, so an instance that has not said who it is
# publishes no policy rather than one naming somebody else.
#
#   LEGAL_ENTITY=Example Lda
#   LEGAL_CONTACT_EMAIL=privacy@example.com
#
# Read the pages before you publish them. They describe what this software
# actually stores and what it cannot read, which is most of the work, but the
# company details, the retention periods you actually keep to, the governing
# law if you want a clause naming one, and anything your own lawyer requires
# are yours to add and check.
LEGAL_ENTITY=
LEGAL_CONTACT_EMAIL=

# Optional. Leave both unset to build the two images from this source, which
# is the default and needs nothing here. Set them to run published images
# instead, which skips compiling Rust on your server:
#
#   KRYPTA_API_IMAGE=ghcr.io/<owner>/krypta-api:0.1.0
#   KRYPTA_WEB_IMAGE=ghcr.io/<owner>/krypta-web:0.1.0
#
# Then `docker compose pull` before `up -d`. Pin a version rather than using
# `latest`, so an upgrade is something you choose. Published images are built
# for amd64 and arm64 and carry build provenance, so `gh attestation verify`
# can confirm an image came from the commit it claims.
#
# Building from source stays supported on purpose: every question, answer and
# file is encrypted in the browser, and anyone relying on that should be able
# to run code they have read rather than a binary handed to them.
KRYPTA_API_IMAGE=
KRYPTA_WEB_IMAGE=
